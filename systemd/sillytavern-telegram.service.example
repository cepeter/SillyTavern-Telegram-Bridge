[Unit]
Description=SillyTavern Telegram Bridge

[Service]
Type=simple
WorkingDirectory=%h/sillytavern-telegram-bridge
Environment=SILLYTAVERN_ENV_FILE=%h/.local/share/sillytavern-telegram/.env
Environment=SILLYTAVERN_BRIDGE_HOME=%h/.local/share/sillytavern-telegram
Environment=SILLYTAVERN_BRIDGE_SOURCE_DIR=%h/sillytavern-telegram-bridge
Environment=SILLYTAVERN_LIVE_BRIDGE_DIR=%h/.local/share/sillytavern-telegram/live
ExecStart=%h/sillytavern-telegram-bridge/.venv/bin/python %h/sillytavern-telegram-bridge/sillytavern_telegram_bridge.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/sillytavern-telegram-bridge %h/.local/share/sillytavern-telegram -%h/.local/share/SillyTavern/data/default-user -%h/.cache/huggingface
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128

[Install]
WantedBy=default.target
