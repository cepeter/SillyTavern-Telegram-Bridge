# SillyTavern Telegram Bridge user configuration
# Recommended location: ~/.local/share/sillytavern-telegram/.env
# Keep the real file outside Git. On POSIX: chmod 600 <file>.

# --- Required bot/session defaults ---
# Telegram bot token from BotFather.
SILLYTAVERN_TELEGRAM_BOT_TOKEN=
# Required comma-separated numeric Telegram user IDs allowed to use the bot.
SILLYTAVERN_TELEGRAM_ALLOWED_USERS=
# SillyTavern installation directory. Default: ~/.local/share/SillyTavern
# SILLYTAVERN_DIR=~/.local/share/SillyTavern
# Existing PNG filename from the configured character directory.
SILLYTAVERN_DEFAULT_CHARACTER=example-character.png
# provider-id::model-id from the private provider catalog.
SILLYTAVERN_MODEL=example-provider::example-model
# Optional display name used for {{user}} when no Persona-specific name applies.
# SILLYTAVERN_DEFAULT_USER_NAME=User
# Optional Telegram custom-emoji IDs for S/A/B/C/D character-rank buttons.
# Requires Bot API custom-emoji eligibility (bot owner Premium or Fragment entitlement).
# IDs are numeric strings; invalid/missing values fall back to plain rank letters.
# SILLYTAVERN_RANK_EMOJI_S=
# SILLYTAVERN_RANK_EMOJI_A=
# SILLYTAVERN_RANK_EMOJI_B=
# SILLYTAVERN_RANK_EMOJI_C=
# SILLYTAVERN_RANK_EMOJI_D=

# --- Provider credentials ---
# Generic fallback key. Prefer provider-specific api_key_env entries in the YAML catalog.
LLM_API_KEY=
# Examples only; use the variable names referenced by your own provider catalog.
# PROVIDER_ONE_API_KEY=
# PROVIDER_TWO_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Bridge paths and model catalog ---
# SILLYTAVERN_ENV_FILE selects which .env file is loaded. Set it in the process/systemd
# environment when using a non-default path; a value inside the file cannot select itself.
# SILLYTAVERN_ENV_FILE=/path/to/private-bridge.env
# SILLYTAVERN_BRIDGE_HOME=~/.local/share/sillytavern-telegram
# Source checkout used by /update. Default: the repository containing bridge/settings.py.
# SILLYTAVERN_BRIDGE_SOURCE_DIR=~/sillytavern-telegram-bridge
# Managed live mirror used by /update. Default: $SILLYTAVERN_BRIDGE_HOME/live
# SILLYTAVERN_LIVE_BRIDGE_DIR=~/.local/share/sillytavern-telegram/live
# SILLYTAVERN_PROVIDER_CONFIG=~/.local/share/sillytavern-telegram/sillytavern_telegram_providers.yaml
# SILLYTAVERN_MODEL_CACHE=~/.local/share/sillytavern-telegram/model_catalog_cache.json
# Range: 1..86400 seconds. Default: 3600.
# SILLYTAVERN_MODEL_REFRESH_SECONDS=3600

# --- Provider/network egress policy ---
# Every external provider/image hostname must be listed exactly. Empty means deny external hosts.
# SILLYTAVERN_PROVIDER_ALLOWED_HOSTS=provider.example,api.example
# LAN/tailnet provider hosts need this separate opt-in. Remote provider URLs still require HTTPS.
# SILLYTAVERN_PROVIDER_PRIVATE_HOSTS=provider.internal.example
# OpenCode Muse client header version. Default: 1.18.31
# OPENCODE_CLIENT_VERSION=1.18.31

# --- Prompt/context planning ---
# Range: 4096..1000000. Default: 32768.
# SILLYTAVERN_CONTEXT_WINDOW_TOKENS=32768
# Range: 512..131072. Default: 4096.
# SILLYTAVERN_CONTEXT_OUTPUT_RESERVE_TOKENS=4096
# Range: 8..512. Default: 96.
# SILLYTAVERN_CONTEXT_HISTORY_CANDIDATES=96
# Optional performance-span logging. Accepted true values: true/yes/on/1. Default: false.
# SILLYTAVERN_PERF_LOG=false

# --- Native SillyTavern paths ---
# Defaults derive from SILLYTAVERN_DIR.
# SILLYTAVERN_CHARACTER_DIR=/path/to/SillyTavern/data/default-user/characters
# SILLYTAVERN_CHARACTER_BACKUP_DIR=~/.local/share/sillytavern-telegram/backups/sillytavern/characters
# SILLYTAVERN_WORLD_DIR=/path/to/SillyTavern/data/default-user/worlds
# SILLYTAVERN_SYSTEM_PROMPTS_DIR=/path/to/SillyTavern/data/default-user/sysprompt
# SILLYTAVERN_NATIVE_SETTINGS_FILE=/path/to/SillyTavern/data/default-user/settings.json
# SILLYTAVERN_NATIVE_AVATAR_DIR=/path/to/SillyTavern/data/default-user/User Avatars
# Enforce private permission checks on prompt files where supported. Default: false.
# SILLYTAVERN_ENFORCE_PROMPT_PERMISSIONS=false

# --- Hindsight memory (optional) ---
# Default local endpoint: http://127.0.0.1:8890
# HINDSIGHT_API_URL=http://127.0.0.1:8890
# HINDSIGHT_API_KEY=
# External Hindsight hostname allowlist.
# SILLYTAVERN_HINDSIGHT_ALLOWED_HOSTS=memory.example
# Separate LAN/tailnet opt-in.
# SILLYTAVERN_HINDSIGHT_PRIVATE_HOSTS=memory.internal.example

# --- Data Bank semantic embeddings (optional) ---
# Default local endpoint: http://127.0.0.1:8891/v1/embeddings
# SILLYTAVERN_RAG_EMBEDDING_URL=http://127.0.0.1:8891/v1/embeddings
# Dedicated key is required for external embedding endpoints.
# SILLYTAVERN_RAG_EMBEDDING_API_KEY=
# SILLYTAVERN_RAG_ALLOWED_HOSTS=embedding.example
# SILLYTAVERN_RAG_PRIVATE_HOSTS=embedding.internal.example
# SILLYTAVERN_RAG_EMBEDDING_MODEL=text-embedding-3-small
# Range: 1..65536. Default: 1536.
# SILLYTAVERN_RAG_EMBEDDING_DIMENSIONS=1536
# Change this when the embedding implementation changes; reindex after changing it.
# SILLYTAVERN_RAG_EMBEDDING_REVISION=1
# Range: 1..10000000. Default: 1000000.
# SILLYTAVERN_RAG_MAX_EXTRACTED_CHARS=1000000
# Range: 1..10000. Default: 200.
# SILLYTAVERN_RAG_MAX_PDF_PAGES=200
# Range: 1..300 seconds. Default: 45.
# SILLYTAVERN_RAG_PDF_PARSE_TIMEOUT_SECONDS=45
# Range: 64..2048. Default: 384.
# SILLYTAVERN_RAG_SEMANTIC_CANDIDATES=384

# --- Live Sync with SillyTavern (optional; off when URL is empty) ---
# SILLYTAVERN_SYNC_API_URL=http://127.0.0.1:8000
# SILLYTAVERN_SYNC_API_HANDLE=
# SILLYTAVERN_SYNC_API_PASSWORD=
# Range: 2..30 seconds. Default: 10.
# SILLYTAVERN_SYNC_API_TIMEOUT_SECONDS=10
# Range: 1..30 seconds. Default: 2.0.
# SILLYTAVERN_SYNC_API_INTERVAL_SECONDS=2

# --- Voice (optional) ---
# Whisper/faster-whisper model name. Default: base.
# SILLYTAVERN_STT_MODEL=base
# Edge TTS executable. Default: $SILLYTAVERN_BRIDGE_HOME/venv/bin/edge-tts
# SILLYTAVERN_TTS_BIN=/path/to/edge-tts
# Required when TTS output is enabled.
# SILLYTAVERN_TTS_VOICE=en-US-AriaNeural

# --- Signed self-update (optional, required for automatic /update) ---
# Allowed-signers file must be outside both source and live trees and contain public keys only.
# SILLYTAVERN_UPDATE_ALLOWED_SIGNERS=/path/to/private-config/trusted-maintainers
# User systemd unit restarted after a successful update. Default: sillytavern-telegram.service
# SILLYTAVERN_UPDATE_SERVICE=sillytavern-telegram.service
